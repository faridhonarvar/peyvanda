{
	"image_size": "medium",
	"fields": {
		"accent": { "type": "color", "default": "#2563eb", "css": "accent" },
		"gap": { "type": "number", "default": 16, "min": 0, "max": 40, "unit": "px", "css": "gap" },
		"radius": { "type": "number", "default": 10, "min": 0, "max": 24, "unit": "px", "css": "radius" },
		"columns": { "type": "select", "default": "1", "options": [ "1", "2" ], "css": "columns" },
		"show_image": { "type": "toggle", "default": true },
		"show_excerpt": { "type": "toggle", "default": true },
		"show_price": { "type": "toggle", "default": true }
	}
}
